# ==========================================================================
# Copie este arquivo para .env e preencha com os valores do seu projeto.
# Dashboard: https://supabase.com/dashboard → Project Settings
# ==========================================================================

# Postgres via Connection Pooler (Project Settings → Database → Connection string)
# DATABASE_URL: Transaction pooler (porta 6543) — usado pelo app em runtime
# DIRECT_URL:   Session pooler (porta 5432) — usado pelo Prisma CLI (migrations)
DATABASE_URL="postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-X-regiao.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-X-regiao.pooler.supabase.com:5432/postgres"

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL="https://SEU_PROJETO.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sua-anon-key"

# URL pública do site (links de peça na mensagem WhatsApp e OpenGraph)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
